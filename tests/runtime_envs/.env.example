# Copy to tests/runtime_envs/.env (gitignored) for model-driven setup tests.
# Any OpenAI-compatible endpoint works; defaults target the PNNL AI Incubator Depot.
# Model options: https://ai-incubator-depot.pnnl.gov/models
LLM_API_KEY=
LLM_BASE_URL=https://ai-incubator-api.pnnl.gov
LLM_MODEL=claude-sonnet-5-5-project
# Optional. Claude models on the Depot reject temperature=0; leave blank for the default.
LLM_TEMPERATURE=
