{
  "title": "Explicit partial in-place economizer settings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "output_model_path"
  ],
  "$defs": {
    "selector": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "handle"
          ],
          "properties": {
            "handle": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  },
  "properties": {
    "output_model_path": {
      "type": "string",
      "minLength": 1
    },
    "air_loop": {
      "$ref": "#/$defs/selector"
    },
    "economizer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "control_type": {
          "type": "string",
          "enum": [
            "NoEconomizer",
            "FixedDryBulb",
            "FixedEnthalpy",
            "DifferentialDryBulb",
            "DifferentialEnthalpy",
            "FixedDewPointAndDryBulb",
            "ElectronicEnthalpy",
            "DifferentialDryBulbAndEnthalpy"
          ]
        },
        "lockout_type": {
          "type": "string",
          "enum": [
            "NoLockout",
            "LockoutWithHeating",
            "LockoutWithCompressor"
          ]
        },
        "maximum_dry_bulb_c": {
          "oneOf": [
            {
              "type": "number",
              "minimum": -100,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "minimum_dry_bulb_c": {
          "oneOf": [
            {
              "type": "number",
              "minimum": -100,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "maximum_dewpoint_c": {
          "oneOf": [
            {
              "type": "number",
              "minimum": -100,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "maximum_enthalpy_j_kg": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 300000
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
