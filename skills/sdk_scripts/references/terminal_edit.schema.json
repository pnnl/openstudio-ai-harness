{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "In-place VAV terminal airflow and reheat controls",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "output_model_path"
  ],
  "$defs": {
    "selector": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "handle"
          ],
          "properties": {
            "handle": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  },
  "properties": {
    "output_model_path": {
      "type": "string",
      "minLength": 1
    },
    "air_loop": {
      "$ref": "#/$defs/selector"
    },
    "zone": {
      "$ref": "#/$defs/selector"
    },
    "terminal": {
      "$ref": "#/$defs/selector"
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimum_airflow_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "damper_heating_action": {
          "type": "string",
          "enum": [
            "Normal",
            "Reverse",
            "ReverseWithLimits"
          ]
        },
        "maximum_reheat_temperature_c": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "maximum_reheat_flow_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maximum_reheat_flow_per_area_m3_s_m2": {
          "type": "string",
          "enum": [
            "Autosize"
          ],
          "description": "Explicitly reset the per-area reheat field to SDK Autosize / EnergyPlus Autocalculate. Numeric per-area edits are unsupported because EnergyPlus 25.2 discards them."
        }
      }
    }
  }
}
