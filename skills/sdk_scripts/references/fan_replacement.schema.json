{
  "title": "Genuine direct supply-fan class replacement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "output_model_path"
  ],
  "$defs": {
    "selector": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "handle"
          ],
          "properties": {
            "handle": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  },
  "properties": {
    "end_use_subcategory": {
      "type": "string",
      "minLength": 1
    },
    "output_model_path": {
      "type": "string",
      "minLength": 1
    },
    "air_loop": {
      "$ref": "#/$defs/selector"
    },
    "target_class": {
      "type": "string",
      "enum": [
        "ConstantVolume",
        "VariableVolume"
      ]
    },
    "fan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total_efficiency": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "motor_efficiency": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "pressure_rise": {
          "type": "number",
          "minimum": 0
        },
        "pressure_units": {
          "enum": [
            "Pa",
            "inH2O"
          ],
          "type": "string"
        }
      }
    },
    "sizing": {
      "type": "string",
      "enum": [
        "Autosize"
      ]
    },
    "terminal_policy": {
      "type": "string",
      "enum": [
        "Preserve"
      ]
    },
    "system_sizing_policy": {
      "type": "string",
      "enum": [
        "Preserve"
      ]
    },
    "reference_policy": {
      "type": "string",
      "enum": [
        "Reject"
      ]
    },
    "variable_volume": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimum_power_flow_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "power_coefficients": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "number"
          }
        }
      }
    }
  }
}
