{
  "title": "Variable-speed cooling tower design fan power",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "output_model_path"
  ],
  "$defs": {
    "selector": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "handle"
          ],
          "properties": {
            "handle": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  },
  "properties": {
    "output_model_path": {
      "type": "string",
      "minLength": 1
    },
    "plant_loop": {
      "$ref": "#/$defs/selector"
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "design_fan_power_w"
      ],
      "properties": {
        "design_fan_power_w": {
          "oneOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "string",
              "enum": [
                "Autosize"
              ]
            }
          ],
          "description": "Explicit total tower electrical watts at design airflow, or explicit Autosize. Autosized design airflow depends on this power; not per-cell watts or motor horsepower."
        }
      }
    },
    "tower": {
      "$ref": "#/$defs/selector"
    }
  }
}
