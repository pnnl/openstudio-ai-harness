{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenStudio AI Asset Manifest",
  "type": "object",
  "required": ["version", "assets"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "enum": [2] },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/asset" }
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "required": ["path"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Repository-relative source path. Glob patterns are allowed for references."
        },
        "agent": { "$ref": "#/$defs/agent" },
        "references": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/reference" }
        }
      },
      "anyOf": [
        { "required": ["agent"] },
        { "required": ["references"] }
      ]
    },
    "hosts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["claude", "codex"] }
    },
    "agent": {
      "type": "object",
      "required": ["hosts", "name"],
      "additionalProperties": false,
      "properties": {
        "hosts": { "type": "array", "const": ["claude"] },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "reference": {
      "type": "object",
      "required": ["hosts", "skill"],
      "additionalProperties": false,
      "properties": {
        "hosts": { "$ref": "#/$defs/hosts" },
        "skill": {
          "type": "string",
          "minLength": 1,
          "description": "Owning exported skill. The adapter derives its references directory."
        },
        "subdirectory": {
          "type": "string",
          "minLength": 1,
          "description": "Optional relative directory below the skill's references directory."
        }
      }
    }
  }
}
