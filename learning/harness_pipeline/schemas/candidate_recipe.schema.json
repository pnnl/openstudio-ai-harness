{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenStudio SI Candidate Recipe",
  "type": "object",
  "required": ["name", "status", "summary", "source"],
  "properties": {
    "name": {"type": "string"},
    "status": {"const": "candidate"},
    "summary": {"type": "string"},
    "source": {"const": "harness_pipeline"},
    "script_excerpt": {"type": "string"},
    "review_required": {"type": "boolean"}
  },
  "additionalProperties": true
}

