{
  "name": "OpenStudio AI Harness (Python 3.12)",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "postCreateCommand": "uv sync --extra dev --locked && uv sync --project standalone --locked",
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": {
      "label": "Streamlit",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  }
}
