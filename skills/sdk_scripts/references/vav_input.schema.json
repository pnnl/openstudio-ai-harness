{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VAV preflight configuration (partial inputs allowed)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "system_name": {
      "type": "string",
      "minLength": 1
    },
    "output_model_path": {
      "type": "string",
      "minLength": 1
    },
    "target_zones": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/selector"
      }
    },
    "defaults_profile": {
      "enum": [
        "prototype_vav_v1"
      ]
    },
    "central_heating": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "Water",
            "NaturalGas",
            "Electricity",
            "None"
          ]
        },
        "plant_loop": {
          "$ref": "#/$defs/selector"
        },
        "dx_approved": {
          "type": "boolean"
        }
      }
    },
    "central_cooling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "Water",
            "DXTwoSpeed"
          ]
        },
        "plant_loop": {
          "$ref": "#/$defs/selector"
        },
        "dx_approved": {
          "type": "boolean"
        }
      }
    },
    "reheat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "Water",
            "NaturalGas",
            "Electricity",
            "None"
          ]
        },
        "plant_loop": {
          "$ref": "#/$defs/selector"
        },
        "dx_approved": {
          "type": "boolean"
        }
      }
    },
    "fan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total_efficiency": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "motor_efficiency": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "pressure_rise": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "pressure_units": {
          "enum": [
            "Pa",
            "inH2O"
          ]
        }
      }
    },
    "availability_schedule": {
      "oneOf": [
        {
          "$ref": "#/$defs/selector"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "builtin": {
              "enum": [
                "AlwaysOnDiscrete"
              ]
            }
          },
          "required": [
            "builtin"
          ]
        }
      ]
    },
    "outdoor_air_schedule": {
      "oneOf": [
        {
          "oneOf": [
            {
              "$ref": "#/$defs/selector"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "builtin": {
                  "enum": [
                    "AlwaysOnDiscrete"
                  ]
                }
              },
              "required": [
                "builtin"
              ]
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "minimum_system_airflow_ratio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "minimum_terminal_airflow_fraction": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "sizing_option": {
      "enum": [
        "Coincident",
        "NonCoincident"
      ]
    },
    "economizer": {
      "enum": [
        "NoEconomizer",
        "FixedDryBulb",
        "DifferentialDryBulb"
      ]
    },
    "design_temperatures_c": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preheat": {
          "type": "number",
          "minimum": -50,
          "maximum": 100
        },
        "precool": {
          "type": "number",
          "minimum": -50,
          "maximum": 100
        },
        "central_heating": {
          "type": "number",
          "minimum": -50,
          "maximum": 100
        },
        "central_cooling": {
          "type": "number",
          "minimum": -50,
          "maximum": 100
        },
        "zone_heating": {
          "type": "number",
          "minimum": -50,
          "maximum": 100
        },
        "zone_cooling": {
          "type": "number",
          "minimum": -50,
          "maximum": 100
        }
      }
    },
    "return_plenum": {
      "oneOf": [
        {
          "$ref": "#/$defs/selector"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "handle": {
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "required": [
            "name"
          ]
        },
        {
          "required": [
            "handle"
          ]
        }
      ]
    }
  }
}
