{
  "title": "In-place electric EIR chiller reference COP",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "output_model_path"
  ],
  "$defs": {
    "selector": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "handle"
          ],
          "properties": {
            "handle": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  },
  "properties": {
    "output_model_path": {
      "type": "string",
      "minLength": 1
    },
    "plant_loop": {
      "$ref": "#/$defs/selector"
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_cop"
      ],
      "properties": {
        "reference_cop": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Explicit reference cooling watts per electric watt at the retained reference conditions; not IPLV or seasonal COP. Values below 2 or above 10 trigger a non-blocking unit/rating plausibility warning; explicit inputs are not converted."
        }
      }
    },
    "chiller": {
      "$ref": "#/$defs/selector"
    }
  }
}
